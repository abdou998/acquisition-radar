# ============================================================
# Daily Undervalued Online Business Acquisition Radar Configuration
# ============================================================

# Acquisition Budget Limits (USD)
RADAR_MAX_NORMAL_BUDGET=1000.0
RADAR_MAX_EXCEPTIONAL_BUDGET=5000.0
RADAR_MIN_PRICE=50.0

# Schedule Settings (Default: 08:00 Africa/Casablanca time)
RADAR_SCHEDULE_TIME=08:00
RADAR_TIMEZONE=Africa/Casablanca

# Storage & Reports Directory
RADAR_DB_PATH=radar.db
RADAR_REPORTS_DIR=reports

# Optional Delivery Channels: Email (SMTP)
RADAR_ENABLE_EMAIL=false
RADAR_SMTP_HOST=smtp.gmail.com
RADAR_SMTP_PORT=587
RADAR_SMTP_USER=your_email@gmail.com
RADAR_SMTP_PASSWORD=your_app_password
RADAR_SMTP_SENDER="Acquisition Radar <your_email@gmail.com>"
RADAR_EMAIL_RECIPIENT=buyer@example.com

# Optional Delivery Channels: Telegram Bot
RADAR_ENABLE_TELEGRAM=false
RADAR_TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
RADAR_TELEGRAM_CHAT_ID=123456789

# Optional Marketplace API Keys (for enhanced rate limits)
FLIPPA_API_KEY=
ACQUIRE_API_KEY=

# Optional SEO Data APIs (System uses smart open heuristics by default)
SERP_API_KEY=
OPEN_PAGERANK_KEY=
